# ============================================================
# 环境变量模板
# 用法：cp .env.example .env  然后把 change_me 换成真实值
# 注意：.env 已在 .gitignore 中，绝不要提交到 git
# ============================================================

# ---------- 应用 ----------
APP_NAME=AI-RPA Platform
APP_ENV=development
DEBUG=true
API_V1_PREFIX=/api/v1
APP_HOST=127.0.0.1
APP_PORT=8000

# ---------- 解释器 ----------
# scripts/*.sh 用它来跑 Python。填绝对路径，别填 `python3` ——
# PATH 里的 python3 往往不是装了依赖的那个环境，报错信息会非常误导。
# 本机示例：/opt/anaconda3/envs/ai-rpa/bin/python
PYTHON_BIN=python3

# ---------- MySQL（主库）----------
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=ai_rpa
MYSQL_PASSWORD=change_me
MYSQL_DB=ai_rpa

# ---------- Redis ----------
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=

# ---------- JWT ----------
# 生成方式：python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=change_me_to_a_long_random_string
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=720

# ---------- 初始管理员 ----------
# 只被 scripts/seed_admin.py 读取，用它在 users 表里建出第一个管理员。
# 只在「还没有任何管理员」时有意义，建过之后改这里不会影响已有账号。
ADMIN_USERNAME=admin
ADMIN_PASSWORD=

# ---------- 初始 RPA Worker ----------
# 只被 scripts/seed_worker.py 读取。Worker 是**独立账号**（role=WORKER），
# 只能调 /rpa/* —— 拿管理员账号跑 Worker，等于把整站管理权限发到那台机器上。
WORKER_USERNAME=rpa-worker
WORKER_PASSWORD=

# ---------- AI（OpenAI 兼容接口）----------
AI_BASE_URL=https://api.deepseek.com/v1
AI_API_KEY=
AI_MODEL=deepseek-chat
AI_TIMEOUT_SECONDS=30

# ---------- 队列与 Worker（**后端/作业进程**读的）----------
# Redis 里任务队列的键名
TASK_QUEUE_KEY=ai_rpa:task_queue
# Redis 里 AI 分析队列的键名。**和任务队列分开**：任务队列按优先级出队
# （HIGH 能插队），分析队列只能 FIFO —— 分析前不知道紧急度，那正是分析的产物。
# 成员是 order_id。
AI_QUEUE_KEY=ai_rpa:ai_queue
# 「导入已提交、但还没进分析队列」的容许时长（秒）。超过这么久仍是 IMPORTED
# 就判定入队那步失败了，由补偿任务重新推回队列（services/ai_reconciler.py）。
AI_ENQUEUE_GRACE_SECONDS=60
# 订单停在 ANALYZING 超过这个时长（秒）就判定分析进程中途死了，
# 置回 IMPORTED 重排队。与 ZOMBIE_TIMEOUT_SECONDS 同一套思路。
AI_ANALYZING_TIMEOUT_SECONDS=300
# 任务领取后多久没心跳算僵尸（秒）
ZOMBIE_TIMEOUT_SECONDS=300
# 僵尸扫描间隔（秒）
ZOMBIE_SCAN_INTERVAL_SECONDS=60
# AI Worker 并发数
AI_WORKER_CONCURRENCY=5

# ---------- RPA Worker（**Worker 进程自己**读的）----------
# 这一节由 scripts/run_rpa_worker.sh 起的那个进程读取（rpa/common/config.py）。
# 反过来说：Worker **不读**上面的 MYSQL_* / REDIS_* —— 它跟主平台只有 HTTP
# 一条通道，这也是 rpa/requirements.txt 能比后端瘦一大截的原因。
#
# 主平台 API 地址（含 /api/v1）。**留空**即按 APP_HOST/APP_PORT 推导，
# 本地开发不用填。要指到别的机器上时才填完整地址。
RPA_API_BASE_URL=
# 写进 tasks.claimed_by，也是心跳和回传时的自称。**必须与领任务时一致**，
# 否则服务端会认为「这活不归你」（心跳回 cancel、回传回 409）。
RPA_WORKER_NAME=rpa-worker-01
# 无头运行。演示时用 `--headed` 覆盖，不必改这里。
RPA_HEADLESS=true
# 页面导航超时（毫秒）。必须**明显大于** MOCK_ERP_PAGE_DELAY_MS，
# 否则每次跳转都会假超时。
RPA_NAV_TIMEOUT_MS=15000
# 单次操作（等元素出现、点击）的超时（毫秒）。
RPA_ACTION_TIMEOUT_MS=10000
# claim 的长轮询秒数，取值 0~30（服务端上限，超了直接 400）。
# >0 时队列为空会挂起等待，而不是空转打接口。
RPA_POLL_WAIT_SECONDS=20
# 心跳间隔（秒）。服务端按 ZOMBIE_TIMEOUT_SECONDS 判僵尸，
# 30 秒一次意味着要连丢很多次心跳才会被误判。
RPA_HEARTBEAT_SECONDS=30

# ---------- 模拟 ERP（独立服务，仅 RPA 的浏览器操作它）----------
# MOCK_ERP_BASE_URL 是**后端**读的：它作为 instruction.erp_url 下发给 Worker，
# 所以换环境只改这一处，Worker 端不用重新配置（《API接口设计》§10.1）。
MOCK_ERP_BASE_URL=http://127.0.0.1:8001
# 这两项是**Worker** 读的：ERP 的登录凭据只能本地配 ——
# 服务端不会把别人的口令随 instruction 发下来。
MOCK_ERP_USERNAME=erp_operator
MOCK_ERP_PASSWORD=change_me

# 下面这一组是给**模拟 ERP 自己那个进程**用的（scripts/start_mock_erp.sh 读）。
MOCK_ERP_HOST=127.0.0.1
MOCK_ERP_PORT=8001
# 独立库。连接串优先取 MOCK_ERP_DB_URL；没配就用上面的 MYSQL_* 账号，
# 只把库名换成 MOCK_ERP_DB —— 本地开发不必为此多维护一份账号密码。
MOCK_ERP_DB=mock_erp
# 这一项**保持注释**：留空即为「按 MYSQL_* + MOCK_ERP_DB 推导」，
# 只有想连一个完全独立的库时才取消注释并填完整的 mysql+asyncmy:// 串。
# MOCK_ERP_DB_URL=mysql+asyncmy://user:pass@host:3306/mock_erp?charset=utf8mb4
# 会话签名密钥。生成方式同上（secrets.token_urlsafe(48)）。默认值是开发用的
# 固定串，上线前必须换 —— 否则谁都能自己伪造一个已登录的 session cookie。
MOCK_ERP_SESSION_SECRET=change_me_to_a_long_random_string
# 会话过期时间（分钟）。过期后任意页面都被踢回 /login。
MOCK_ERP_SESSION_MINUTES=30
# 页面跳转延时（毫秒）。刻意保留的摩擦，逼 RPA 用显式等待而不是 sleep 硬等。
# 测试里会被 conftest 钉成 0，不必为了跑测试去改这一行。
MOCK_ERP_PAGE_DELAY_MS=1500
# 故障注入概率，取值 [0, 1]，0.2 表示 20%。**只作用在写操作上**
# （保存 / 提交审核 / 审核通过），GET 永远不受影响。
# 默认必须为 0：不为 0 的话开发阶段会被随机失败折磨。只在演示/测试时调大。
MOCK_ERP_FAIL_RATE=0
# 是否挂载审核页 /review。关掉它相当于模拟「这个 ERP 没有审核环节」。
MOCK_ERP_ENABLE_REVIEW_PAGE=true

# ---------- RPA 失败截图 ----------
# 截图落盘目录，**刻意放在 webroot 之外**：图里是客户姓名/电话/地址明文，
# 能被无鉴权 GET 到就等于一边给订单列表脱敏、一边从截图漏出去。
# 默认值 backend/var/screenshots。取图只能走
# GET /api/v1/tasks/{id}/executions/{eid}/screenshot（需管理员 JWT）。
# 这一项**保持注释**：留一个空的 SCREENSHOT_DIR= 会被解析成当前目录 `.`，
# 反而把截图丢得到处都是。要改就取消注释并填绝对路径。
# SCREENSHOT_DIR=/abs/path/to/screenshots
# 单张截图上限（字节）。默认 5MB。
SCREENSHOT_MAX_BYTES=5242880
